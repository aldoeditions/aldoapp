# ─────────────────────────────────────────────────────────────
# Aldo Éditions — variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# (récupérables dans Supabase → Project Settings → API)
# ⚠️ Ne jamais committer `.env.local` (il est git-ignored).
# ─────────────────────────────────────────────────────────────

# URL du projet Supabase (publique)
NEXT_PUBLIC_SUPABASE_URL=

# Clé anon publique Supabase (côté navigateur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role Supabase — SECRÈTE, serveur uniquement.
# Utilisée pour l'upload Storage et l'invitation d'artistes.
# Ne JAMAIS l'exposer côté client ni la committer.
SUPABASE_SERVICE_ROLE_KEY=

# Classement Drive des contrats signés — connexion OAuth utilisateur (voir
# REPRISE.md pour la marche à suivre). Identifiants du client OAuth « Web »
# créé dans Google Cloud Console (écran de consentement). Le secret ne doit
# JAMAIS être commité.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Id du dossier Drive `ALDO/Artistes` (dans l'URL du dossier).
GOOGLE_DRIVE_ARTISTES_FOLDER_ID=
